    <string name="test_intro_title">Movement age test</string>
    <string name="test_intro_text">Five exercises, about 10 minutes. You need some space, a mat and a stopwatch. Any test can be skipped.</string>
    <string name="test_disclaimer">This is an estimate against age norms, not a medical measure.</string>
    <string name="test_start">Take the test</string>
    <string name="test_later">Later</string>
