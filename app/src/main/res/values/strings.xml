    <string name="test_intro_title">Movement age test</string>
    <string name="test_intro_text">Five exercises and a five-question health check, about 15 minutes. You will need some free space, a mat, a stopwatch and a tape measure. Any step can be skipped. At the end — your movement age, body mass index and degree of obesity, waist risk, heart fitness and endurance.</string>
    <string name="test_disclaimer">This is an estimate against age norms, not a medical measure.</string>
    <string name="test_start">Take the test</string>
    <string name="test_later">Later</string>
    <string name="test_n_of">Test %1$d of %2$d</string>
    <string name="test_record">Save</string>
    <string name="test_skip">Skip</string>
    <string name="test_done">Done</string>
    <string name="test_sit_rise">Sit down and rise from the floor</string>
    <string name="test_sit_rise_how">Barefoot, sit down on the floor cross-legged and stand up again, without support if you can. Start at 10 points. Minus 1 for each support (hand, forearm, knee, side of leg), minus 0.5 for losing balance.</string>
    <string name="test_fold">Standing forward fold</string>
    <string name="test_fold_how">Stand on a step or sturdy box, knees straight. Slowly fold and reach down. Centimetres below your feet are plus, short of them are minus.</string>
    <string name="test_balance">Balance with eyes closed</string>
    <string name="test_balance_how">Stand on one leg, hands on hips, close your eyes. Time until the other foot touches down or the standing foot moves. Best of three tries.</string>
    <string name="test_push_ups">Push-ups</string>
    <string name="test_push_ups_how">Classic push-ups from the toes, chest nearly touching the floor. As many as you can without rest and with good form.</string>
    <string name="test_hr">Heart rate recovery</string>
    <string name="test_hr_how">Do 6 fast rounds of the salutation, take your pulse at once, then again after 60 seconds. Enter the difference. Skip it if you have no heart rate monitor.</string>
